+static void acs_record_channel_usage(struct hostapd_iface *iface, int freq, enum nr_chan_width bw, int secondary_channel_offset)
+{
+	struct hostapd_channel_data *chan = NULL;
+	struct bw_item *bw_item = NULL;
+	u16 secondary_channel_freq = 0;
+	u8 n_chans;
+	int i, j;
+
+	switch (bw) {
+		case NR_CHAN_WIDTH_160:
+			n_chans = 8;
+			break;
+		case NR_CHAN_WIDTH_80:
+			n_chans = 4;
+			break;
+		case NR_CHAN_WIDTH_40:
+			n_chans = 2;
+			break;
+		case NR_CHAN_WIDTH_20:
+		default:
+			n_chans = 1;
+			break;
+	}
+
+	if (!is_24ghz_mode(iface->current_mode->mode)) {
+		if (bw == NR_CHAN_WIDTH_20) {
+			chan = acs_find_chan(iface, freq);
+			if (!chan) {
+				wpa_printf(MSG_ERROR, "ACS: Failed to find channel, freq:%d\n", freq);
+				return;
+			}
+
+			for (i = 0; i < sizeof(channel_usage_5G) / sizeof(struct channel_usage); i++) {
+				if (channel_usage_5G[i].freq == chan->freq)
+					channel_usage_5G[i].used = 1;
+			}
+		} else {
+			/* "bw - 1" to convert type of band width in enum nr_chan_width to enum bw_type */
+			bw_item = acs_get_bw_item(freq, (enum bw_type)(bw - 1));
+			if (!bw_item) {
+				wpa_printf(MSG_ERROR, "ACS: Failed to get bw_item, freq:%d, bw:%d\n", freq, bw);
+				return;
+			}
+
+			for (i = 0; i < n_chans; i++) {
+				chan = acs_find_chan(iface, bw_item->first + i * 20);
+				if (!chan) {
+					wpa_printf(MSG_ERROR, "ACS: Failed to find channel, first freq:%d\n", bw_item->first);
+					return;
+				}
+
+				for (j = 0; j < sizeof(channel_usage_5G) / sizeof(struct channel_usage); j++) {
+					if (channel_usage_5G[j].freq == chan->freq)
+						channel_usage_5G[j].used = 1;
+				}
+			}
+		}
+	} else {
+		/* For 2.4G, only focus on the primary channel. */
+		for (i = 0; i < n_chans; i++) {
+			chan = acs_find_chan(iface, freq + (i * secondary_channel_offset * 20) - 5);
+			if (chan) {
+				for (j = 0; j < sizeof(channel_usage_24G) / sizeof(struct channel_usage); j++) {
+					if (channel_usage_24G[j].freq == chan->freq)
+						channel_usage_24G[j].used = 1;
+				}
+			}
+
+			chan = acs_find_chan(iface, freq + (i * secondary_channel_offset * 20) - 10);
+			if (chan) {
+				for (j = 0; j < sizeof(channel_usage_24G) / sizeof(struct channel_usage); j++) {
+					if (channel_usage_24G[j].freq == chan->freq)
+						channel_usage_24G[j].used = 1;
+				}
+			}
+
+			chan = acs_find_chan(iface, freq + (i * secondary_channel_offset * 20));
+			if (chan) {
+				for (j = 0; j < sizeof(channel_usage_24G) / sizeof(struct channel_usage); j++) {
+					if (channel_usage_24G[j].freq == chan->freq)
+						channel_usage_24G[j].used = 1;
+				}
+			}
+
+			chan = acs_find_chan(iface, freq + (i * secondary_channel_offset * 20) + 5);
+			if (chan) {
+				for (j = 0; j < sizeof(channel_usage_24G) / sizeof(struct channel_usage); j++) {
+					if (channel_usage_24G[j].freq == chan->freq)
+						channel_usage_24G[j].used = 1;
+				}
+			}
+
+			chan = acs_find_chan(iface, freq + (i * secondary_channel_offset * 20) + 10);
+			if (chan) {
+				for (j = 0; j < sizeof(channel_usage_24G) / sizeof(struct channel_usage); j++) {
+					if (channel_usage_24G[j].freq == chan->freq)
+						channel_usage_24G[j].used = 1;
+				}
+			}
+		}
+	}
+}
