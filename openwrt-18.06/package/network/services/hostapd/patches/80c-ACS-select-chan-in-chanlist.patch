+static int acs_have_unused_channel(struct hostapd_iface *iface, struct hostapd_channel_data *chan, u32 bw, u8 *is_unused)
+{
+	int i, j, have_unused_chan = 0;
+	struct hostapd_channel_data *tmp_chan = NULL;
+
+	*is_unused = 0;
+	if (!is_24ghz_mode(iface->current_mode->mode)) {
+		for (i = 0; i < sizeof(channel_usage_5G) / sizeof(struct channel_usage); i++) {
+			/* Get Corresponding channel data */
+			for (j = 0; j < iface->current_mode->num_channels; j++) {
+				tmp_chan = &iface->current_mode->channels[j];
+				if (tmp_chan->freq == channel_usage_5G[i].freq)
+					break;
+			}
+
+			if (!chan_bw_allowed(tmp_chan, bw, 1, 1)) {
+				wpa_printf(MSG_INFO, "ACS: Channel %d: BW %u is not supported", tmp_chan->chan, bw);
+				continue;
+			}
+
+			if (channel_usage_5G[i].used)
+				continue;
+
+			have_unused_chan = 1;
+			if (channel_usage_5G[i].freq == chan->freq) {
+				wpa_printf(MSG_INFO, "ACS: Channel %d: BW %u is unused", chan->chan, bw);
+				*is_unused = 1;
+			}
+		}
+	} else {
+		for (i = 0; i < sizeof(channel_usage_24G) / sizeof(struct channel_usage); i++) {
+			/* Get Corresponding channel data */
+			for (j = 0; j < iface->current_mode->num_channels; j++) {
+				tmp_chan = &iface->current_mode->channels[j];
+				if (tmp_chan->freq == channel_usage_24G[i].freq)
+					break;
+			}
+
+			if (!chan_bw_allowed(tmp_chan, bw, 1, 1)) {
+				wpa_printf(MSG_INFO, "ACS: Channel %d: BW %u is not supported", tmp_chan->chan, bw);
+				continue;
+			}
+
+			if (channel_usage_24G[i].used)
+				continue;
+
+			have_unused_chan = 1;
+			if (channel_usage_24G[i].freq == chan->freq) {
+				wpa_printf(MSG_INFO, "ACS: Channel %d: BW %u is unused", chan->chan, bw);
+				*is_unused = 1;
+			}
+		}
+	}
+
+	return have_unused_chan;
+}
