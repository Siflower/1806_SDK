+static void acs_get_bss_info(struct hostapd_iface *iface)
+{
+	struct ieee80211_vht_capabilities *vht_cap = NULL;
+	struct ieee80211_he_capabilities *he_cap = NULL;
+	struct ieee80211_ht_capabilities *ht_cap = NULL;
+	struct ieee80211_ht_operation* ht_oper = NULL;
+	struct wpa_scan_results *scan_res = NULL;
+	struct ieee802_11_elems elems;
+	int i, secondary_channel_offset = 0;
+	enum nr_chan_width bw;
+	u8 *pos = NULL;
+
+	scan_res = hostapd_driver_get_scan_results(iface->bss[0]);
+	if (scan_res == NULL) {
+		wpa_printf(MSG_ERROR, "ACS: Failed to get scan results\n");
+		return;
+	}
+
+	for (i = 0; i < scan_res->num; i++) {
+		struct wpa_scan_res *res = scan_res->res[i];
+		pos = (u8 *) res + sizeof(*res);
+
+		/* Exclude the impact of APs with weak signals */
+		if (res->level < ACS_SIGNAL_STRENGTH_THRESHOLD) {
+			wpa_printf(MSG_INFO, "ACS: BSSID(%02x:%02x:%02x:%02x:%02x:%02x) signal strength(%d) is too weak, signal strength threshold(%d)\n",
+				res->bssid[0], res->bssid[1], res->bssid[2], res->bssid[3], res->bssid[4], res->bssid[5], res->level, ACS_SIGNAL_STRENGTH_THRESHOLD);
+			continue;
+		}
+
+		if (ieee802_11_parse_elems(pos, res->ie_len, &elems, 0) == ParseFailed) {
+			wpa_printf(MSG_ERROR, "ACS: Failed to parse scan results, BSSID(%02x:%02x:%02x:%02x:%02x:%02x)\n",
+					res->bssid[0], res->bssid[1], res->bssid[2], res->bssid[3], res->bssid[4], res->bssid[5]);
+			continue;
+		}
+
+		/* Get Band Width Information */
+		if (elems.he_capabilities && !is_24ghz_mode(iface->current_mode->mode)) {
+			he_cap = (struct ieee80211_he_capabilities *) elems.he_capabilities;
+			wpa_printf(MSG_INFO, "ACS: HE PHY Capabilities info:%x\n", he_cap->he_phy_capab_info[0]);
+
+			if (he_cap->he_phy_capab_info[0] & HE_PHYCAP_CHANNEL_WIDTH_SET_80PLUS80MHZ_IN_5G)
+				bw = NR_CHAN_WIDTH_80P80;
+			else if (he_cap->he_phy_capab_info[0] & HE_PHYCAP_CHANNEL_WIDTH_SET_160MHZ_IN_5G)
+				bw = NR_CHAN_WIDTH_160;
+			else if (he_cap->he_phy_capab_info[0] & HE_PHYCAP_CHANNEL_WIDTH_SET_40MHZ_80MHZ_IN_5G)
+				bw = NR_CHAN_WIDTH_80;
+			else
+				bw = NR_CHAN_WIDTH_80;	/* 80MHz for default */
+		} else if (elems.vht_capabilities && !is_24ghz_mode(iface->current_mode->mode)) {
+			vht_cap = (struct ieee80211_vht_capabilities *) elems.vht_capabilities;
+			wpa_printf(MSG_INFO, "ACS: VHT Capabilities info:%x\n", vht_cap->vht_capabilities_info);
+
+			if (vht_cap->vht_capabilities_info & VHT_CAP_SUPP_CHAN_WIDTH_160_80PLUS80MHZ)
+				bw = NR_CHAN_WIDTH_80P80;
+			else if (vht_cap->vht_capabilities_info & VHT_CAP_SUPP_CHAN_WIDTH_160MHZ)
+				bw = NR_CHAN_WIDTH_160;
+			else
+				bw = NR_CHAN_WIDTH_80;	/* 80MHz for default */
+		} else if (elems.ht_capabilities) {
+			ht_cap = (struct ieee80211_ht_capabilities *) elems.ht_capabilities;
+			wpa_printf(MSG_INFO, "ACS: HT Capabilities info:%x\n", ht_cap->ht_capabilities_info);
+			if (ht_cap->ht_capabilities_info & HT_CAP_INFO_SUPP_CHANNEL_WIDTH_SET) {
+				bw = NR_CHAN_WIDTH_40;
+
+			/* For 40MHz bandwidth, temporarily ignore the secondary channel; the code below can be enabled if needed. */
+#if 0
+				secondary_channel_offset = 1; /* HT40+ for default */
+				if (elems.ht_operation) {
+					ht_oper = (struct ieee80211_ht_operation *) elems.ht_operation;
+					wpa_printf(MSG_INFO,"ACS: HT INFORMATION: %x\n", ht_oper->ht_param);
+					switch (ht_oper->ht_param & HT_INFO_HT_PARAM_SECONDARY_CHNL_OFF_MASK) {
+						case 1:
+							secondary_channel_offset = 1; /* HT40+ */
+							break;
+						case 3:
+							secondary_channel_offset = -1; /* HT40- */
+							break;
+						default:
+							break;
+					}
+				}
+#endif
+			} else {
+				bw = NR_CHAN_WIDTH_20;
+				secondary_channel_offset = 0;
+			}
+		} else {
+			if (is_24ghz_mode(iface->current_mode->mode)) {
+				bw = NR_CHAN_WIDTH_20;	/* 20MHz for 2.4G default */
+				secondary_channel_offset = 0;
+			}
+			else
+				bw = NR_CHAN_WIDTH_80;	/* 80MHz for 5G default */
+		}
+
+		wpa_printf(MSG_INFO, "ACS: BSSID(%02x:%02x:%02x:%02x:%02x:%02x) freq:%d bw:%d, second:%d\n",
+							res->bssid[0], res->bssid[1], res->bssid[2], res->bssid[3], res->bssid[4],
+											res->bssid[5], res->freq, bw, secondary_channel_offset);
+		/* Record Channel Usage */
+		acs_record_channel_usage(iface, res->freq, bw, secondary_channel_offset);
+	}
+
+	/* Dump Channel Usage for Debug */
+	if (!is_24ghz_mode(iface->current_mode->mode)) {
+		for (i = 0; i < sizeof(channel_usage_5G) / sizeof(struct channel_usage); i++) {
+			wpa_printf(MSG_INFO, "ACS: 5G Channel(%d) Usage(%d)\n", channel_usage_5G[i].freq, channel_usage_5G[i].used);
+		}
+	} else {
+		for (i = 0; i < sizeof(channel_usage_24G) / sizeof(struct channel_usage); i++) {
+			wpa_printf(MSG_INFO, "ACS: 24G Channel(%d) Usage(%d)\n", channel_usage_24G[i].freq, channel_usage_24G[i].used);
+		}
+	}
+}
